APP_BASE_URL=
NODE_ENV=production
ADMIN_SETUP_KEY=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-long-random-value

# Render automatically provides RENDER_EXTERNAL_URL; APP_BASE_URL is an optional override.
# Add these MySQL values in Render's Environment settings.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Set to true only if your MySQL provider requires TLS.
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth provider callback URLs use your Render service URL:
# https://your-service.onrender.com/auth/google/callback
# https://your-service.onrender.com/auth/kakao/callback
# Kakao Developers에서 OpenID Connect를 활성화해야 합니다.
# Google은 OpenID Connect의 기본 프로필과 이메일 정보만 요청합니다.
# Kakao Developers에서 OpenID Connect와 닉네임 정보 제공을 설정할 수 있습니다. 이메일 동의는 요청하지 않습니다.
