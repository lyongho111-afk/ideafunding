<%- include('./include/_header') %>
<main class="container page">
  <div class="section-heading"><div><p class="eyebrow">YOUR WORKSPACE</p><h1>내 아이디어</h1></div><a class="button primary" href="/ideas/new">새 아이디어 제안</a></div>
  <section class="idea-grid">
    <% if (ideas.length) { ideas.forEach((idea) => { %>
      <article class="idea-card">
        <div class="card-top"><span class="tag"><%= idea.category %></span><span class="status <%= idea.storage_mode === 'private' ? 'private' : idea.status %>"><%= idea.storage_mode === 'private' ? '비공개 보관' : {pending:'검수 대기', approved:'공개 중', rejected:'반려'}[idea.status] %></span></div>
        <h3><a href="/ideas/<%= idea.id %>"><%= idea.title %></a></h3><p><%= idea.summary %></p>
        <div class="idea-meta"><span>예약액 <strong><%= Number(idea.pledged).toLocaleString('ko-KR') %>원</strong></span><span>목표 <strong><%= Number(idea.funding_goal).toLocaleString('ko-KR') %>원</strong></span></div>
      </article>
    <% }); } else { %><div class="empty-state"><h3>등록한 아이디어가 없습니다.</h3><a class="text-link" href="/ideas/new">첫 아이디어 제안하기 →</a></div><% } %>
  </section>
</main>
<%- include('./include/_footer') %>
