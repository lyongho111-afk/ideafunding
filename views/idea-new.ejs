<%- include('./include/_header') %>
<main class="container page narrow">
  <div class="section-heading"><div><p class="eyebrow">NEW PROPOSAL</p><h1>아이디어 제안</h1></div></div>
  <div class="notice">상세 내용은 본인의 개인키로 암호화됩니다. 펀딩 공개를 선택하면 검수용 미리보기도 관리자 공개키로 암호화해 제출합니다.</div>
  <form class="panel form-stack" id="idea-form" method="post" action="/ideas">
    <fieldset class="storage-choice">
      <legend>저장 방식</legend>
      <label><input type="radio" name="storageMode" value="private" checked> 내 아이디어로 비공개 저장</label>
      <label><input type="radio" name="storageMode" value="funding" <%= adminConfigured ? '' : 'disabled' %>> 펀딩 받도록 공개 <%= adminConfigured ? '' : '(관리자 검수 설정 후 이용 가능)' %></label>
    </fieldset>
    <label>아이디어 제목<input name="title" maxlength="100" required></label>
    <label>카테고리<input name="category" maxlength="40" placeholder="예: 기후테크, 교육" required></label>
    <label class="funding-only" hidden>공개 요약 <small>관리자와 모든 방문자에게 공개됩니다.</small><textarea name="summary" maxlength="600" rows="4"></textarea></label>
    <label class="funding-only" hidden>목표 모금액 (원)<input name="fundingGoal" type="number" min="1000" max="1000000000" step="1000"></label>
    <label>상세 아이디어 <small>전체 내용은 본인만 복호화할 수 있습니다. 펀딩 공개를 선택하면 앞부분 약 50%가 관리자 검수용으로 암호화됩니다.</small><textarea id="details" rows="9" required></textarea></label>
    <button class="button primary" type="submit">비공개로 저장</button>
    <p id="form-status" class="muted" aria-live="polite"></p>
  </form>
</main>
<script src="/js/idea-crypto.js"></script>
<script>
const ideaForm = document.getElementById("idea-form");
const storageOptions = Array.from(ideaForm.elements.storageMode);
const fundingFields = Array.from(document.querySelectorAll(".funding-only"));
const submitButton = ideaForm.querySelector("button[type=submit]");
const updateStorageFields = () => {
  const isFunding = ideaForm.elements.storageMode.value === "funding";
  fundingFields.forEach((field) => {
    field.hidden = !isFunding;
    field.querySelectorAll("input, textarea").forEach((input) => { input.required = isFunding; });
  });
  submitButton.textContent = isFunding ? "암호화하고 검수 요청" : "비공개로 저장";
};
storageOptions.forEach((option) => option.addEventListener("change", updateStorageFields));
updateStorageFields();

ideaForm.addEventListener("submit", async (event) => {
  event.preventDefault();
  const form = event.currentTarget;
  const status = document.getElementById("form-status");
  try {
    const privateKey = window.IdeaCrypto.getPrivateKey(<%- JSON.stringify(currentUser.username).replace(/</g, "\\u003c") %>);
    if (!privateKey) throw new Error("이 브라우저에서 개인키를 찾을 수 없습니다. 개인키 파일을 다른 브라우저에 가져오거나 다시 로그인해 주세요.");
    const details = document.getElementById("details").value;
    const characters = Array.from(details);
    if (characters.length < 2) throw new Error("상세 내용은 2자 이상 입력해 주세요.");
    const result = await window.IdeaCrypto.encrypt(details, JSON.parse(<%- JSON.stringify(publicKey).replace(/</g, "\\u003c") %>));
    const storageMode = form.elements.storageMode.value;
    const payload = {
      storageMode,
      title: form.elements.title.value,
      category: form.elements.category.value,
      ...result
    };
    if (storageMode === "funding") {
      const preview = characters.slice(0, Math.ceil(characters.length / 2)).join("");
      const review = await window.IdeaCrypto.encrypt(preview, JSON.parse(<%- JSON.stringify(adminPublicKey).replace(/</g, "\\u003c") %>));
      Object.assign(payload, {
        summary: form.elements.summary.value,
        fundingGoal: form.elements.fundingGoal.value,
        reviewPreview: review.encryptedDetails,
        reviewWrappedKey: review.wrappedKey
      });
    }
    status.textContent = "상세 내용을 암호화해 전송합니다...";
    const response = await fetch(form.action, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    if (!response.ok) throw new Error(await response.text());
    window.location.href = "/ideas/my";
  } catch (error) {
    status.textContent = error.message;
  }
});
</script>
<%- include('./include/_footer') %>
