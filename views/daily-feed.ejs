<%- include('./include/_header') %>
<main class="container page narrow">
  <div class="section-heading"><div><p class="eyebrow">COMMUNITY</p><h1>오늘의 일상</h1></div></div>
  <p class="notice">짧은 생각과 일상을 나누고 다른 사람의 글에 공감해 보세요.</p>
  <% if (currentUser) { %>
    <form class="panel form-stack daily-composer" action="/ideas/feed" method="post">
      <label for="post-content">오늘의 한마디<textarea id="post-content" name="content" rows="3" maxlength="500" placeholder="지금의 생각이나 일상을 남겨보세요." required></textarea></label>
      <button class="button primary" type="submit">게시하기</button>
    </form>
  <% } else { %>
    <p class="notice"><a class="text-link" href="/login">로그인</a>하면 일상을 작성하고 공감할 수 있습니다.</p>
  <% } %>
  <section class="daily-post-list">
    <% if (posts.length) { posts.forEach((post) => { %>
      <article class="panel daily-post">
        <div class="daily-post-heading"><strong><%= post.author_name %></strong><time><%= post.created_at %></time></div>
        <p class="daily-post-content"><%= post.content %></p>
        <div class="daily-actions">
          <% if (currentUser) { %>
            <form action="/ideas/feed/<%= post.id %>/likes" method="post">
              <button class="text-button" type="submit" aria-label="좋아요"><%= post.liked ? '♥ 공감 취소' : '♡ 공감' %> · <%= post.like_count %></button>
            </form>
          <% } else { %><span>♡ 공감 · <%= post.like_count %></span><% } %>
          <span>댓글 · <%= post.comment_count %></span>
        </div>
        <div class="daily-comments">
          <% post.comments.forEach((comment) => { %>
            <p><strong><%= comment.author_name %></strong> <%= comment.content %></p>
          <% }); %>
        </div>
        <% if (currentUser) { %>
          <form class="daily-comment-form" action="/ideas/feed/<%= post.id %>/comments" method="post">
            <input name="content" maxlength="300" placeholder="댓글을 남겨보세요" aria-label="댓글" required>
            <button class="button secondary" type="submit">등록</button>
          </form>
        <% } %>
      </article>
    <% }); } else { %>
      <div class="empty-state"><h3>아직 일상 글이 없습니다</h3><p>첫 번째 글을 남겨보세요.</p></div>
    <% } %>
  </section>
</main>
<%- include('./include/_footer') %>
