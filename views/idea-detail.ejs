<%- include('./include/_header') %>
<main class="container page narrow">
  <a class="text-link back-link" href="/ideas">← 아이디어 목록</a>
  <article class="detail-card panel">
    <div class="card-top"><span class="tag"><%= idea.category %></span><span class="status <%= idea.status %>"><%= {pending:'검수 대기', approved:'공개 중', rejected:'반려'}[idea.status] %></span></div>
    <h1><%= idea.title %></h1>
    <p class="detail-summary"><%= idea.summary %></p>
    <div class="idea-meta"><span>제안자 <strong><%= idea.owner_name %></strong></span><span>목표 <strong><%= Number(idea.funding_goal).toLocaleString('ko-KR') %>원</strong></span></div>
    <p class="notice">예약 금액은 실제 결제되지 않습니다. 이 데모는 결제사 연동 전 단계이며 에스크로 자금 보관을 제공하지 않습니다.</p>

    <% if (owner) { %>
      <section class="private-section">
        <h2>내 암호화 상세 내용</h2>
        <p>전체 상세 내용은 본인의 개인키로만 복호화할 수 있습니다. 검수자는 제출된 앞부분 약 50%만 별도로 확인할 수 있습니다. 개인키를 분실하면 전체 내용을 복구할 수 없습니다.</p>
        <label class="file-label">개인키 파일 불러오기<input type="file" id="private-key-file" accept="application/json"></label>
        <button class="button secondary" id="decrypt-own">내 상세 내용 열기</button>
        <pre class="decrypted-content" id="own-details" hidden></pre>
      </section>
      <% if (backers.length) { %>
        <section class="private-section">
          <h2>에스크로 예약자에게 상세 공개</h2>
          <p>상세 내용은 브라우저에서 예약자 공개키로 다시 암호화되어 전달됩니다.</p>
          <% backers.forEach((backer) => { %>
            <div class="backer-row">
              <span><strong><%= backer.username %></strong> · <%= Number(backer.amount).toLocaleString('ko-KR') %>원 예약</span>
              <button class="button secondary disclose-button" data-backer-id="<%= backer.backer_id %>" data-public-key="<%= encodeURIComponent(backer.publicKey) %>">상세 내용 공개</button>
            </div>
          <% }); %>
          <p class="muted" id="disclosure-status" aria-live="polite"></p>
        </section>
      <% } %>
    <% } else if (pledged) { %>
      <section class="private-section">
        <h2>에스크로 예약이 확인되었습니다</h2>
        <% if (disclosure) { %>
          <p>제안자가 상세 내용을 공개했습니다. 개인키 파일이 이 브라우저에 있어야 열람할 수 있습니다.</p>
          <label class="file-label">개인키 파일 불러오기<input type="file" id="private-key-file" accept="application/json"></label>
          <button class="button secondary" id="decrypt-shared">공개된 상세 내용 열기</button>
          <pre class="decrypted-content" id="shared-details" hidden></pre>
        <% } else { %><p>제안자가 상세 내용을 공개하면 이곳에서 확인할 수 있습니다.</p><% } %>
      </section>
      <section class="private-section">
        <h2>제안자에게 질문하기</h2>
        <form method="post" action="/ideas/<%= idea.id %>/questions" class="form-stack">
          <label>질문<textarea name="question" maxlength="1000" rows="3" required></textarea></label>
          <button class="button primary">질문 보내기</button>
        </form>
      </section>
    <% } else if (idea.status === "approved" && currentUser && !currentUser.publicKey) { %>
      <div class="notice">에스크로 예약 전에 <a href="/ideas/key-setup">암호화 키를 설정</a>해 주세요.</div>
    <% } else if (idea.status === "approved" && currentUser) { %>
      <% if (currentUser._id !== idea.owner_id) { %>
        <section class="private-section">
          <h2>상세 내용을 확인하고 질문하기</h2>
          <p>목표 모금액의 5% 이상을 에스크로 예약하면 제안자에게 질문할 수 있습니다.</p>
          <form method="post" action="/ideas/<%= idea.id %>/pledges" class="pledge-form">
            <label>예약 금액 (원)<input type="number" name="amount" min="<%= Math.ceil(idea.funding_goal / 20) %>" max="1000000000" step="1" value="<%= Math.ceil(idea.funding_goal / 20) %>" required></label>
            <button class="button primary">에스크로 예약하고 질문 자격 얻기</button>
          </form>
        </section>
      <% } %>
    <% } else if (idea.status === "approved") { %>
      <div class="notice">질문과 상세 내용 열람은 <a href="/login">로그인</a> 후 에스크로 예약이 필요합니다.</div>
    <% } %>
  </article>

  <% if (questions.length) { %>
    <section class="question-section">
      <h2><%= owner ? "예약자의 질문" : "질문과 답변" %></h2>
      <% questions.forEach((item) => { %>
        <article class="question-card">
          <p class="muted"><%= item.asker_name %> · <%= item.created_at %></p><p><%= item.question %></p>
          <% if (item.answer) { %><div class="answer"><strong>제안자 답변</strong><p><%= item.answer %></p></div>
          <% } else if (owner) { %>
            <form method="post" action="/ideas/<%= idea.id %>/questions/<%= item.id %>/answer" class="form-stack">
              <label>답변<textarea name="answer" maxlength="2000" rows="2" required></textarea></label><button class="button secondary">답변 등록</button>
            </form>
          <% } %>
        </article>
      <% }); %>
    </section>
  <% } %>
</main>
<script id="idea-crypto-data" type="application/json"><%- JSON.stringify({
  owner,
  username: currentUser && currentUser.username,
  ideaId: idea.id,
  encryptedDetails: idea.encrypted_details,
  wrappedKey: idea.wrapped_key,
  disclosure,
  backers: backers.map((backer) => ({ id: backer.backer_id, publicKey: backer.publicKey }))
}).replace(/</g, "\\u003c") %></script>
<script src="/js/idea-crypto.js"></script><script src="/js/idea-detail.js"></script>
<%- include('./include/_footer') %>
